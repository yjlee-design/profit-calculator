# 이 파일을 복사해서 secrets.toml 로 이름을 바꾼 뒤 값을 채우세요.
#   .streamlit/secrets.toml  ← 이 파일은 깃허브에 올라가지 않습니다(.gitignore)
#
# Streamlit Cloud 에 올릴 때는 앱 설정 화면의 [Secrets] 칸에 아래 내용을 그대로 붙여넣으세요.

# 화면 접속 비밀번호 (여러 개 넣으면 아무거나 통과)
passwords = ["여기에-비밀번호"]

[db]
# Supabase → Project Settings → Database → Connection string → URI
# 반드시 [Connection pooling] 의 Session/Transaction 주소를 쓰세요 (포트 6543 또는 5432)
# 반드시 [Connection pooling] 주소를 쓰세요. 직접 연결(db.xxx.supabase.co:5432)은
# IPv6 전용이라 Streamlit Cloud 에서 접속되지 않습니다.
# 예: postgresql://postgres.프로젝트ID:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
url = "postgresql://..."
